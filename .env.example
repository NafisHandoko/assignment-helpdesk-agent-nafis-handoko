# Salin file ini menjadi .env, lalu isi API key milikmu sendiri.
# JANGAN commit file .env ke repository (sudah di-exclude di .gitignore).

# API key Gemini AI (wajib untuk jalur utama).
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API key OpenRouter (opsional, untuk fallback otomatis ketika Gemini
# tidak tersedia, misal karena pembatasan region).
# Dapatkan di https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here